DATABASE_URL=sqlite:///./medical_supply.db
# Generate independent keys with the commands in SETUP.md. Never commit .env.
AUTH_SIGNING_KEY=replace-with-at-least-32-random-characters
TOTP_ENCRYPTION_KEY=replace-with-a-Fernet-key
SESSION_MINUTES=30
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
NTFY_ENABLED=false
NTFY_URL=https://ntfy.example.org
NTFY_TOKEN=replace-with-backend-publisher-token
NTFY_TOPICS={"H01":"msi-h01","H02":"msi-h02"}
